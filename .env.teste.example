# ============================================================
#  PublicaMED · AMBIENTE DE TESTE
# ------------------------------------------------------------
#  Copie este arquivo para ".env.teste" e preencha com as chaves
#  do projeto Supabase de TESTE (nunca as do projeto real).
#
#  Depois, para trabalhar sem risco:
#      npm run dev:teste
#  O painel abre com uma tarja avisando que está no banco de
#  teste. O `npm run dev` normal continua indo para produção.
#
#  Como montar o projeto de teste (uma vez só):
#    1. supabase.com → New project (o plano free permite 2)
#    2. SQL Editor → cole supabase/setup-ambiente-teste.sql → Run
#    3. SQL Editor → cole supabase/11-planejamento.sql    → Run
#    4. Authentication → Users → Add user → e-mail + senha,
#       marcando "Auto Confirm User" (sem isso o login não passa)
#    5. Project Settings → API → copie os dois valores abaixo
# ============================================================

VITE_SUPABASE_URL=https://SEU-PROJETO-DE-TESTE.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key-do-projeto-de-teste

# Liga a tarja de aviso no topo do painel. Não mexa.
VITE_AMBIENTE=teste
